[
	{
		"label": "CMake Configure Desktop",
		"command": "cmake",
		"args": [
			"-D",
			"CMAKE_POLICY_VERSION_MINIMUM=3.5",
			"-G",
			"Ninja",
			"-B",
			"cmake-build-citron",
		],
		"use_new_terminal": false,
	},
	{
		"label": "Build Desktop",
		"command": "cmake",
		"args": ["--build", "cmake-build-citron", "--target", "citron_editor"],
		"use_new_terminal": false,
	},
	{
		"label": "Run Desktop",
		"command": "./cmake-build-citron/editor/citron_editor.exe",
		"args": ["C:\\Dev\\CitronDemo\\demo.project.yaml"],
		"use_new_terminal": false,
	},
]
